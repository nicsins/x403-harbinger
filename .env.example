# Grant binding store (Upstash Redis REST; Vercel Marketplace "Upstash for Redis" sets the KV_* pair).
# Required in production for hp1.<txHash> grants. Without it, production answers tx grants with 503.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names, also accepted:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Explicit per-instance fallback (replay possible across instances). Do not set in production unless accepted.
# GRANT_STORE=memory
# Optional Base RPC override (default https://mainnet.base.org)
# BASE_RPC_URL=
