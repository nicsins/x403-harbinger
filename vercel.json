{
  "crons": [
    {
      "path": "/api/cron/notify-pump",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://nicsins.com https://*.nicsins.com"
        }
      ]
    },
    {
      "source": "/(api|pay|checkout|wallet|login|auth|admin)(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ]
}
